<UserControl x:Class="TaskTodo.App.Controls.TaskRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TaskTodo.App.Controls"
    AllowDrop="True" DragOver="Row_OnDragOver" Drop="Row_OnDrop">
    <Border x:Name="RowBorder" Padding="{DynamicResource TaskRowPadding}" Margin="0,0,0,1" CornerRadius="8" BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/></Trigger>
                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="24"/>
            </Grid.ColumnDefinitions>
            <local:TaskCheckBox Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="1,1,0,0"
                      IsChecked="{Binding IsCompleted, Mode=OneWay}" CompletionRequested="Completion_OnRequested"
                      IsEnabled="{Binding DataContext.CanInteract, RelativeSource={RelativeSource AncestorType=Window}}"
                      AutomationProperties.Name="{Binding Title}" ToolTip="完成 / 取消完成"
                      Style="{StaticResource TaskCheckBoxStyle}"/>
            <Grid Grid.Column="1">
                <TextBlock x:Name="TitleText" Text="{Binding Title}" TextWrapping="Wrap"
                           Padding="0,0,6,0" FontSize="13" LineHeight="20" LineStackingStrategy="BlockLineHeight" MouseLeftButtonDown="Title_OnMouseDown">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <local:TaskTextBox x:Name="Editor" Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                       Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                       IsReadOnly="{Binding DataContext.IsInputReadOnly, RelativeSource={RelativeSource AncestorType=Window}}"
                       TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="140" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0"
                       Background="Transparent" BorderThickness="0" Margin="0,0,0,0"
                       SubmitRequested="Editor_OnSubmit" CancelRequested="Editor_OnCancel"
                       LostKeyboardFocus="Editor_OnLostFocus" CompositionFinished="Editor_OnCompositionFinished"
                       IsVisibleChanged="Editor_OnVisibleChanged" AutomationProperties.Name="编辑任务标题"/>
            </Grid>
            <!-- Row actions only appear while the row is hovered or holds keyboard focus. -->
            <Grid Grid.Column="2" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border x:Name="DragHandle" Background="Transparent" Cursor="SizeAll"
                        PreviewMouseLeftButtonDown="Handle_OnMouseDown"
                        PreviewMouseLeftButtonUp="Handle_OnMouseUp"
                        PreviewMouseMove="Handle_OnMouseMove" ToolTip="拖动排序">
                    <TextBlock Text="&#xE784;" FontFamily="Segoe Fluent Icons" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Button Grid.Column="1" Content="&#xE712;" FontFamily="Segoe Fluent Icons" FontSize="12" ToolTip="任务操作" AutomationProperties.Name="任务操作"
                        Width="24" Height="22" VerticalAlignment="Top" Margin="0,-1,0,0" Click="Menu_OnClick" Style="{StaticResource WindowActionButtonStyle}"
                        IsEnabled="{Binding DataContext.CanInteract, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="编辑" Click="Edit_OnClick"/>
                            <MenuItem Header="删除" Click="Delete_OnClick"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
