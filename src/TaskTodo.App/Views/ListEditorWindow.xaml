<Window x:Class="TaskTodo.App.Views.ListEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TaskTodo.App.Controls"
        Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" UseLayoutRounding="True">
    <Window.Background><SolidColorBrush Color="{DynamicResource SurfaceColor}"/></Window.Background>
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}"/>
    </Window.Resources>
    <StackPanel Margin="28,26,28,24">
        <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}"
                HorizontalAlignment="Left" Margin="0,0,0,16">
            <Path Data="M 1,3 L 3,3 M 6,3 L 16,3 M 1,8 L 3,8 M 6,8 L 16,8 M 1,13 L 3,13 M 6,13 L 13,13"
                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Width="18" Height="14" Stretch="Uniform"/>
        </Border>
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                   FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock Text="用一个清晰的名字，把相关的任务放在一起。" TextWrapping="Wrap"
                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,24"/>
        <TextBlock Text="清单名称" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
        <controls:TaskTextBox x:Name="NameInput" SubmitRequested="Save_OnSubmit" AutomationProperties.AutomationId="ListNameInput"
                              IsReadOnly="{Binding IsInputReadOnly}" MinHeight="42" Padding="12,10" FontSize="14"/>
        <Border Background="{DynamicResource ErrorSurfaceBrush}" CornerRadius="10" Padding="12,10" Margin="0,12,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.LiveSetting="Polite"/>
        </Border>
        <Border Height="1" Background="{DynamicResource SubtleBorderBrush}" Margin="0,26,0,18"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" MinWidth="80" Padding="16,9" Margin="0,0,8,0"
                    IsEnabled="{Binding CanInteract}"/>
            <Button Content="保存" Click="Save_OnClick" MinWidth="88" Padding="16,9"
                    Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanInteract}"
                    AutomationProperties.AutomationId="SaveList"/>
        </StackPanel>
    </StackPanel>
</Window>
