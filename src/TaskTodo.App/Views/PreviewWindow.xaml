<desktop:PassiveWindow x:Class="TaskTodo.App.Views.PreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:desktop="clr-namespace:TaskTodo.App.Desktop"
    xmlns:controls="clr-namespace:TaskTodo.App.Controls"
    Style="{StaticResource AppWindowStyle}" Title="TaskTodo 预览" Width="320" Height="240" MaxHeight="420"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
    ShowActivated="False" ShowInTaskbar="False" Focusable="False"
    Topmost="{Binding IsAlwaysOnTop}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border x:Name="PreviewSurface" Padding="12,12,12,10" CornerRadius="12"
            BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1">
        <Border.Background>
            <SolidColorBrush Color="{DynamicResource SurfaceColor}" Opacity="{Binding SurfaceOpacity}"/>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Padding="4,0,0,10" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ListName}" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PendingSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Click="Open_OnClick" Focusable="False" VerticalAlignment="Center"
                            Style="{StaticResource TextButtonStyle}" Width="58" Height="28" Padding="9,0"
                            Background="{DynamicResource AccentSoftBrush}" Foreground="{DynamicResource AccentTextBrush}"
                            AutomationProperties.Name="打开完整清单">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="打开" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                            <Path Data="M 1,5 L 9,5 M 5,1 L 9,5 L 5,9" Stroke="{DynamicResource AccentTextBrush}"
                                  StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="10" Height="10" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="-4,6,-4,0">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,4"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="还没有任务" HorizontalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="打开清单，记下接下来要做的事" Margin="0,5,0,0" HorizontalAlignment="Center"
                               FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Rows}" Style="{StaticResource TaskListStyle}" Focusable="False"
                         AutomationProperties.Name="预览任务">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,7" Margin="0,0,0,1" CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <controls:TaskCheckBox VerticalAlignment="Top" HorizontalAlignment="Left" Margin="1,0,0,0" Focusable="False"
                                        Style="{StaticResource TaskCheckBoxStyle}" IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                        IsEnabled="{Binding DataContext.CanInteract, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CompletionRequested="Completion_OnRequested" AutomationProperties.Name="{Binding Title}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" MaxHeight="54"
                                               TextTrimming="CharacterEllipsis" FontSize="12.5" LineHeight="18" LineStackingStrategy="BlockLineHeight">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Border Grid.Row="2" Padding="10" Margin="0,8,0,0" CornerRadius="8" Background="{DynamicResource ErrorSurfaceBrush}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource ErrorTextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="-5,5,0,0">
                        <Button Content="重试" Command="{Binding RetryCommand}" Style="{StaticResource TextButtonStyle}" Focusable="False"/>
                        <Button Content="关闭提示" Command="{Binding DismissErrorCommand}" Style="{StaticResource TextButtonStyle}" Focusable="False"
                                Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</desktop:PassiveWindow>
