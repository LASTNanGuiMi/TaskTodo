<Window x:Class="TaskTodo.App.Views.DataManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskTodo — 数据管理" Width="660" Height="700" MinWidth="560" MinHeight="590"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI" UseLayoutRounding="True">
    <Window.Background><SolidColorBrush Color="{DynamicResource SurfaceColor}"/></Window.Background>
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}"/>
    </Window.Resources>
    <Grid Margin="28,26,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="TASKTODO  /  数据管理" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,9"/>
            <TextBlock Text="备份与恢复" FontSize="25" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="保存一份备份，或找回之前的任务。" FontSize="12" Margin="0,7,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,26" IsEnabled="{Binding CanInteract}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Padding="18" CornerRadius="14" Background="{DynamicResource PopupSurfaceBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Border Width="30" Height="30" CornerRadius="9" HorizontalAlignment="Left"
                            Background="{DynamicResource AccentSoftBrush}" Margin="0,0,0,12">
                        <Path Data="M 3,2 L 15,2 15,17 3,17 Z M 6,2 L 6,7 12,7 12,2 M 6,17 L 6,11 12,11 12,17"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4"
                              Width="15" Height="17" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="保存当前数据" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="备份清单与任务，也可导出为文件。" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,16"/>
                    <WrapPanel>
                        <Button Content="创建备份" Click="Backup_OnClick" Style="{StaticResource PrimaryButtonStyle}"
                                Padding="12,8" Margin="0,0,8,4"/>
                        <Button Content="导出 JSON" Click="Export_OnClick" Padding="12,8" Margin="0,0,0,4"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="18" CornerRadius="14" Background="{DynamicResource PopupSurfaceBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <Border Width="30" Height="30" CornerRadius="9" HorizontalAlignment="Left"
                            Background="{DynamicResource AccentSoftBrush}" Margin="0,0,0,12">
                        <Path Data="M 8,1 L 8,12 M 4,8 L 8,12 12,8 M 2,12 L 2,17 14,17 14,12"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4"
                              Width="15" Height="17" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="从文件恢复" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="替换现有数据前，会先创建备份。" TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,16"/>
                    <WrapPanel>
                        <Button Content="导入 JSON" Click="Import_OnClick" Padding="12,8" Margin="0,0,8,4"/>
                        <Button Content="恢复备份" Click="Recover_OnClick" Padding="12,8" Margin="0,0,0,4"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="刷新" Click="Refresh_OnClick" IsEnabled="{Binding CanInteract}"
                    Padding="12,6" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock Text="最近删除" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="恢复后，任务会回到原来的清单。" FontSize="11" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="3" CornerRadius="14" Background="{DynamicResource PopupSurfaceBrush}"
                BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" Padding="6">
            <Grid>
                <ListBox ItemsSource="{Binding DeletedTasks}" Style="{StaticResource TaskListStyle}"
                         Foreground="{DynamicResource TextPrimaryBrush}" IsEnabled="{Binding CanInteract}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,12" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="恢复" Click="RestoreTask_OnClick"
                                            Margin="16,0,0,0" Padding="13,7" VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentBrush}"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="13" TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,6,0,0">
                                            <TextBlock Text="{Binding ListName}" FontSize="11" Margin="0,0,12,0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding DeletedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontSize="11"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="12">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DeletedTasks.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="40" Height="40" CornerRadius="13" Background="{DynamicResource AccentSoftBrush}"
                            HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Path Data="M 2,8 L 6,12 14,3" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                              Width="16" Height="13" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="暂无已删除的任务" FontSize="13" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="删除的任务会保留在这里。" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="12,10" Margin="0,12,0,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Message}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        <DataTrigger Binding="{Binding Message}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.LiveSetting="Polite"/>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,20,0,0">
            <Button DockPanel.Dock="Right" Content="关闭" IsCancel="True" MinWidth="84" Padding="18,8"
                    IsEnabled="{Binding CanInteract}"/>
            <TextBlock Text="你的任务只保存在本地" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                       VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
