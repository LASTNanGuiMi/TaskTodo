<Window x:Class="TaskTodo.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:controls="clr-namespace:TaskTodo.App.Controls"
    xmlns:models="clr-namespace:TaskTodo.Core.Models;assembly=TaskTodo.Core"
    Title="TaskTodo" Icon="/TaskTodo;component/Assets/TaskTodo.ico" Width="340" Height="440" MinWidth="280" MinHeight="260"
    WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
    Background="Transparent" ResizeMode="CanResize" ShowInTaskbar="True"
    Topmost="{Binding IsAlwaysOnTop}" UseLayoutRounding="True" SnapsToDevicePixels="True" Style="{StaticResource AppWindowStyle}">
    <Window.Resources>
        <Thickness x:Key="TaskRowPadding">8,8,4,8</Thickness>
        <GridLength x:Key="CompletedSectionWeight">1*</GridLength>
        <Style x:Key="SettingsGroup" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,2"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="SettingsHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="Margin" Value="4,0,0,6"/>
        </Style>
        <Style x:Key="SettingsRow" TargetType="DockPanel">
            <Setter Property="MinHeight" Value="44"/>
        </Style>
        <Style x:Key="SettingsLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="SettingsDivider" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SubtleBorderBrush}"/>
        </Style>
        <Style x:Key="SettingsGroupButton" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PopupSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
        </Style>
        <Style x:Key="HideWhenEmpty" TargetType="FrameworkElement">
            <Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <!-- A solid panel keeps an 8 DIP margin for its shadow, drawn on its own layer so text never renders through an
             effect. A see-through panel fills the window: DWM blurs behind every visible pixel of the layered window. -->
        <Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="8"/><Style.Triggers>
            <DataTrigger Binding="{Binding IsTranslucent}" Value="True"><Setter Property="Margin" Value="0"/></DataTrigger>
        </Style.Triggers></Style></Grid.Style>
        <Border CornerRadius="12" IsHitTestVisible="False" Visibility="{Binding IsTranslucent, Converter={StaticResource InvertedBool}}">
            <Border.Background><SolidColorBrush Color="{DynamicResource SurfaceColor}"/></Border.Background>
            <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.14" Color="#000000"/></Border.Effect>
        </Border>
        <Border CornerRadius="12" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1">
            <Border.Background><SolidColorBrush Color="{DynamicResource SurfaceColor}" Opacity="{Binding SurfaceOpacity}"/></Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.RowSpan="5" CornerRadius="11" IsHitTestVisible="False" Background="{DynamicResource GlassSheenBrush}"/>

                <StackPanel x:Name="Header" Margin="10,9,8,0">
                    <Grid>
                        <Border Background="Transparent" MouseLeftButtonDown="TitleDragRegion_OnMouseLeftButtonDown" ToolTip="拖动窗口"/>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                <ToggleButton IsChecked="{Binding IsAlwaysOnTop}" ToolTip="置顶开关" AutomationProperties.Name="置顶开关"
                                              FontFamily="Segoe Fluent Icons" FontSize="12" Style="{StaticResource PinButtonStyle}"/>
                                <Button FontFamily="Segoe Fluent Icons" FontSize="13" Content="&#xE713;" ToolTip="设置" AutomationProperties.Name="设置"
                                        Command="{Binding ToggleSettingsCommand}" AutomationProperties.AutomationId="Settings">
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource WindowActionButtonStyle}"><Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></DataTrigger>
                                    </Style.Triggers></Style></Button.Style>
                                </Button>
                                <Button FontFamily="Segoe Fluent Icons" FontSize="10" Content="&#xE8BB;" ToolTip="收起为悬浮窗 (Ctrl+W)；从托盘菜单可完全隐藏"
                                        AutomationProperties.Name="收起到屏幕边缘" Click="DockButton_OnClick" AutomationProperties.AutomationId="DockToEdge"
                                        Style="{StaticResource WindowActionButtonStyle}"/>
                            </StackPanel>
                            <ComboBox x:Name="ListPicker" Style="{StaticResource TitleComboBoxStyle}" ItemsSource="{Binding Lists}" SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedListId, Mode=OneWay}" SelectionChanged="ListPicker_OnSelectionChanged" TextSearch.TextPath="Name"
                                      AutomationProperties.AutomationId="ListPicker" AutomationProperties.Name="切换清单" ToolTip="切换清单"
                                      IsEnabled="{Binding CanInteract}">
                                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                                <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Normal"/>
                                </Style></ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </DockPanel>
                    </Grid>
                    <Border x:Name="PendingSubtitle" Background="Transparent" MouseLeftButtonDown="TitleDragRegion_OnMouseLeftButtonDown" ToolTip="拖动窗口" Margin="6,2,6,0">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CompletionRatio, StringFormat={}{0:P0}}" FontSize="11"
                                           Foreground="{DynamicResource TextTertiaryBrush}" ToolTip="完成进度" Style="{StaticResource HideWhenEmpty}"/>
                                <TextBlock Text="{Binding PendingSummary}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Style="{StaticResource HideWhenEmpty}"/>
                            </DockPanel>
                            <ProgressBar Height="3" Margin="0,7,0,0" Minimum="0" Maximum="1" Value="{Binding CompletionRatio, Mode=OneWay}"
                                         Style="{StaticResource SlimProgressBarStyle}" Visibility="{Binding IsEmpty, Converter={StaticResource InvertedBool}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="1" x:Name="ContentArea" Margin="8,10,8,0">
                    <Grid ClipToBounds="True">
                        <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsSettingsOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition>
                                <RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="Auto"/><Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded, ElementName=CompletedSection}" Value="True"><Setter Property="Height" Value="{DynamicResource CompletedSectionWeight}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding CompletedTasks.Count}" Value="0"><Setter Property="Height" Value="Auto"/></DataTrigger>
                                </Style.Triggers></Style></RowDefinition.Style>
                            </RowDefinition>
                        </Grid.RowDefinitions>
                        <ListBox ItemsSource="{Binding ActiveTasks}" Style="{StaticResource TaskListStyle}" AutomationProperties.AutomationId="TaskScroll" AutomationProperties.Name="未完成任务">
                            <ListBox.ItemTemplate><DataTemplate><controls:TaskRow/></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,12" IsHitTestVisible="False"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <Border x:Name="EmptyIllustration" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Path Data="M 0,7 L 6,13 L 18,0" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                      Width="18" Height="13" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="暂时没有任务" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="在下方记下第一件要做的事" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Expander x:Name="CompletedSection" Grid.Row="1" Header="{Binding CompletedSummary}" IsExpanded="False" Margin="0,4,0,0" FontSize="11.5"
                                  AutomationProperties.AutomationId="CompletedTasks">
                            <Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Style.Triggers>
                                <DataTrigger Binding="{Binding CompletedTasks.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            </Style.Triggers></Style></Expander.Style>
                            <ListBox ItemsSource="{Binding CompletedTasks}" Margin="0,2,0,0" MaxHeight="120" Style="{StaticResource TaskListStyle}" AutomationProperties.Name="已完成任务">
                                <ListBox.ItemTemplate><DataTemplate><controls:TaskRow/></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>
                    </Grid>

                    <ScrollViewer Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="2,0,6,4">
                            <DockPanel Margin="4,0,0,10">
                                <Button DockPanel.Dock="Right" Content="完成" Command="{Binding ToggleSettingsCommand}" Style="{StaticResource TextButtonStyle}"
                                        FontWeight="SemiBold" AutomationProperties.Name="完成设置"/>
                                <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="清单" Style="{StaticResource SettingsHeading}"/>
                            <Border Style="{StaticResource SettingsGroup}" Padding="10">
                                <UniformGrid Columns="2">
                                    <Button Content="新建清单" Click="CreateList_OnClick" AutomationProperties.AutomationId="CreateList" Style="{StaticResource SettingsGroupButton}" IsEnabled="{Binding CanInteract}" Margin="0,0,4,0"/>
                                    <Button Content="重命名" Click="RenameList_OnClick" AutomationProperties.AutomationId="RenameList" Style="{StaticResource SettingsGroupButton}" IsEnabled="{Binding CanInteract}" Margin="4,0,0,0"/>
                                </UniformGrid>
                            </Border>

                            <TextBlock Text="外观" Style="{StaticResource SettingsHeading}"/>
                            <Border Style="{StaticResource SettingsGroup}">
                                <StackPanel>
                                    <DockPanel Style="{StaticResource SettingsRow}">
                                        <ComboBox DockPanel.Dock="Right" Width="112" VerticalAlignment="Center" SelectedValue="{Binding Theme}" SelectedValuePath="Tag" AutomationProperties.Name="主题">
                                            <ComboBoxItem Content="跟随系统" Tag="{x:Static models:ThemePreference.System}"/>
                                            <ComboBoxItem Content="浅色" Tag="{x:Static models:ThemePreference.Light}"/>
                                            <ComboBoxItem Content="深色" Tag="{x:Static models:ThemePreference.Dark}"/>
                                        </ComboBox>
                                        <TextBlock Text="主题" Style="{StaticResource SettingsLabel}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource SettingsDivider}"/>
                                    <DockPanel Style="{StaticResource SettingsRow}">
                                        <ListBox DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SwatchListBoxStyle}" SelectedValuePath="Tag"
                                                 SelectedValue="{Binding Palette}" AutomationProperties.Name="配色" AutomationProperties.AutomationId="PalettePicker">
                                            <ListBoxItem Content="靛紫" Tag="{x:Static models:ColorPalette.Indigo}" Background="#5B5BD6"/>
                                            <ListBoxItem Content="珊瑚" Tag="{x:Static models:ColorPalette.Coral}" Background="#E0663A"/>
                                            <ListBoxItem Content="玫瑰" Tag="{x:Static models:ColorPalette.Rose}" Background="#D9466F"/>
                                            <ListBoxItem Content="琥珀" Tag="{x:Static models:ColorPalette.Amber}" Background="#E89B0C" Margin="0"/>
                                        </ListBox>
                                        <TextBlock Text="配色" Style="{StaticResource SettingsLabel}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource SettingsDivider}"/>
                                    <DockPanel Style="{StaticResource SettingsRow}">
                                        <ListBox DockPanel.Dock="Right" Width="150" VerticalAlignment="Center" Style="{StaticResource SegmentedListBoxStyle}" SelectedValuePath="Tag"
                                                 SelectedValue="{Binding Material}" AutomationProperties.Name="材质" AutomationProperties.AutomationId="MaterialPicker">
                                            <ListBoxItem Content="实色" Tag="{x:Static models:SurfaceMaterial.Solid}" ToolTip="不透明"/>
                                            <ListBoxItem Content="玻璃" Tag="{x:Static models:SurfaceMaterial.Glass}" ToolTip="半透明，身后内容磨砂模糊"/>
                                            <ListBoxItem Content="透明" Tag="{x:Static models:SurfaceMaterial.Clear}" ToolTip="半透明，身后内容清晰可见"/>
                                        </ListBox>
                                        <TextBlock Text="材质" Style="{StaticResource SettingsLabel}"/>
                                    </DockPanel>
                                    <StackPanel Visibility="{Binding IsTranslucent, Converter={StaticResource BoolToVisibility}}">
                                        <Border Style="{StaticResource SettingsDivider}"/>
                                        <DockPanel Margin="0,12,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding BackgroundOpacity, StringFormat={}{0:P0}}" FontSize="12" Foreground="{DynamicResource AccentTextBrush}"/>
                                            <TextBlock Text="背景不透明度" Style="{StaticResource SettingsLabel}"/>
                                        </DockPanel>
                                        <Slider Margin="0,4,0,8" Minimum="0.15" Maximum="0.95" SmallChange="0.05" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                Value="{Binding BackgroundOpacity}" AutomationProperties.Name="背景不透明度"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="收起" Style="{StaticResource SettingsHeading}"/>
                            <Border Style="{StaticResource SettingsGroup}">
                                <StackPanel>
                                    <DockPanel Style="{StaticResource SettingsRow}">
                                        <ComboBox DockPanel.Dock="Right" Width="112" VerticalAlignment="Center" SelectedValue="{Binding DockSide}" SelectedValuePath="Tag" AutomationProperties.Name="停靠方向">
                                            <ComboBoxItem Content="左侧" Tag="{x:Static models:DockSide.Left}"/><ComboBoxItem Content="右侧" Tag="{x:Static models:DockSide.Right}"/>
                                        </ComboBox>
                                        <TextBlock Text="停靠方向" Style="{StaticResource SettingsLabel}"/>
                                    </DockPanel>
                                    <Border Style="{StaticResource SettingsDivider}"/>
                                    <DockPanel Style="{StaticResource SettingsRow}">
                                        <ComboBox DockPanel.Dock="Right" Width="112" VerticalAlignment="Center" SelectedValue="{Binding CollapseStyle}" SelectedValuePath="Tag" AutomationProperties.Name="收起样式">
                                            <ComboBoxItem Content="胶囊条" Tag="{x:Static models:CollapseStyle.Capsule}"/><ComboBoxItem Content="图标球" Tag="{x:Static models:CollapseStyle.Orb}"/>
                                        </ComboBox>
                                        <TextBlock Text="收起样式" Style="{StaticResource SettingsLabel}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Button Click="DataTools_OnClick" AutomationProperties.AutomationId="DataTools" AutomationProperties.Name="备份、导入与最近删除"
                                    Style="{StaticResource DialogButtonStyle}" IsEnabled="{Binding CanInteract}" HorizontalContentAlignment="Stretch"
                                    Background="{DynamicResource ControlSurfaceBrush}" BorderBrush="Transparent" Padding="12,9">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="备份、导入与最近删除" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="2" Margin="10,6,10,0" Padding="10,6" Background="{DynamicResource ErrorSurfaceBrush}" CornerRadius="8"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0">
                            <Button Content="重试" Command="{Binding RetryCommand}" Style="{StaticResource TextButtonStyle}"/>
                            <Button Content="关闭" Command="{Binding DismissErrorCommand}" Style="{StaticResource TextButtonStyle}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ScrollViewer MaxHeight="60" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="11.5"
                            Foreground="{DynamicResource ErrorTextBrush}" AutomationProperties.LiveSetting="Polite"/></ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Row="3" Margin="10,6,10,0" Padding="10,2,4,2" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}"
                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel><Button DockPanel.Dock="Right" Content="撤销" Command="{Binding UndoCommand}" Style="{StaticResource TextButtonStyle}" FontWeight="SemiBold"/>
                        <TextBlock Text="任务已删除" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5"/></DockPanel>
                </Border>
                <Grid x:Name="AddArea" Grid.Row="4" Margin="10,8,10,10">
                    <Border x:Name="QuickAddSurface" CornerRadius="10" Background="{DynamicResource ControlSurfaceBrush}" BorderThickness="1">
                        <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=QuickAdd}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers></Style></Border.Style>
                        <Grid Margin="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <controls:TaskTextBox x:Name="QuickAdd" Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="QuickAdd"
                                IsReadOnly="{Binding IsInputReadOnly}" AcceptsReturn="True" TextWrapping="NoWrap" Background="Transparent" BorderThickness="0" Padding="8,4"
                                VerticalContentAlignment="Center" SubmitRequested="QuickAdd_OnSubmit" AutomationProperties.Name="新增任务" ToolTip="输入任务，按 Enter 添加"/>
                            <TextBlock Text="添加任务，按 Enter 保存" Margin="11,0" FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                    <DataTrigger Binding="{Binding NewTitle}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    <!-- The IME keeps its composition out of Text until a candidate is confirmed. -->
                                    <DataTrigger Binding="{Binding IsComposing, ElementName=QuickAdd}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="1" FontFamily="Segoe Fluent Icons" Content="&#xE710;" FontSize="12" ToolTip="添加任务 (Enter)" AutomationProperties.Name="添加任务"
                                    Click="AddButton_OnClick" AutomationProperties.AutomationId="AddTask" IsEnabled="{Binding CanInteract}"
                                    Width="28" MinHeight="0" Height="28" Padding="0" BorderThickness="0" VerticalAlignment="Center">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}"><Style.Triggers>
                                    <DataTrigger Binding="{Binding NewTitle}" Value="">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers></Style></Button.Style>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
